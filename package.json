{
  "name": "task-foundry",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:azz": "VITE_BASE=/apps/tf/ tsc -b && VITE_BASE=/apps/tf/ vite build",
    "deploy:azz": "npm run build:azz && node scripts/deploy-ftp.mjs",
    "build:native": "tsc -b && vite build",
    "build:ota": "npm run build:native && node scripts/build-ota.mjs",
    "cap:sync": "npm run build:native && npx cap sync",
    "cap:android": "npm run cap:sync && npx cap open android",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "upload:ota": "node scripts/upload-ota-ftp.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capawesome/capacitor-google-sign-in": "^0.1.2",
    "@capgo/capacitor-health": "^8.10.0",
    "@capgo/capacitor-updater": "^8.51.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@capgo/cli": "^8.31.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
